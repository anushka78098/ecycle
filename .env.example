# Copy this file to .env in the project root. Keep real API keys out of Git.
DB_URL=jdbc:postgresql://localhost:5432/ecycle
DB_USER=ecycle
DB_PASSWORD=ecycle
MONGO_URI=mongodb://localhost:27017/ecycle
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
CERT_SIGNING_SECRET=
SEED_DEMO=true
ASSISTANT_PROVIDER=gemini
ASSISTANT_API_KEY=
ASSISTANT_MODEL=gemini-3.1-flash-lite
ASSISTANT_BASE_URL=
PAYMENT_PROVIDER=mock
PUBLIC_BASE_URL=http://localhost:8080
